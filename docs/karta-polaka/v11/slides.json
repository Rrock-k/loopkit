[{"id":"s01","nav":"Старт","kind":"lesson","type":"title","k":"тема 1","title":"Рассказ о себе","text":"Чистый старт. Учимся говорить о себе простыми польскими фразами."},{"id":"s02","nav":"Цель","kind":"lesson","type":"cards","k":"зачем","title":"Нужно не идеально. Нужно понятно.","cards":[["понять вопрос","без паники"],["ответить коротко","2–5 предложений"],["говорить о себе","имя, происхождение, место"],["связать с Польшей","язык, культура, семья"]]},{"id":"s03","nav":"Скелет","kind":"lesson","type":"cards","k":"структура","title":"Ответ о себе = 4 кирпича","cards":[["kto","Nazywam się..."],["skąd","Pochodzę z..."],["gdzie","Teraz mieszkam..."],["dlaczego","Uczę się, ponieważ..."]]},{"id":"s04","nav":"Nazywam się","kind":"lesson","type":"phrase","k":"кирпич 1","title":"Nazywam się Anastazja.","text":"Меня зовут Анастасия."},{"id":"s05","nav":"Имя","kind":"task","type":"formText","k":"задание","title":"Скажи, как тебя зовут","prompt":"Пользователь пишет базовое представление.","formId":"intro.name.clean.v2","formTitle":"Кто я","label":"Jak się pani nazywa?","placeholder":"Напиши ответ по-польски."},{"id":"s06","nav":"Pochodzę z","kind":"lesson","type":"phrase","k":"кирпич 2","title":"Pochodzę z Rosji.","text":"Я родом из России."},{"id":"s07","nav":"Kaukaz","kind":"lesson","type":"phrase","k":"уточнение","title":"a dokładniej z Kaukazu","text":"а точнее с Кавказа"},{"id":"s08","nav":"Откуда","kind":"task","type":"formText","k":"задание","title":"Скажи, откуда ты родом","prompt":"Пользователь пишет, откуда он родом.","formId":"intro.origin.clean.v2","formTitle":"Откуда я родом","label":"Skąd pani pochodzi?","placeholder":"Напиши, откуда ты родом."},{"id":"s09","nav":"Urodziłam się","kind":"lesson","type":"phrase","k":"биография","title":"Urodziłam się w Nalczyku.","text":"Я родилась в Нальчике."},{"id":"s10","nav":"Женская форма","kind":"lesson","type":"rule","k":"маленькое правило","title":"urodziłam się","text":"Для женщины: urodziłam się. Для мужчины: urodziłem się.","tip":"Анастасия говорит о себе, поэтому нужна женская форма с окончанием -łam."},{"id":"s11","nav":"Рождение","kind":"task","type":"formText","k":"задание","title":"Скажи, где ты родилась","prompt":"Пользователь пишет место рождения.","formId":"intro.birth.clean.v2","formTitle":"Где я родилась","label":"Gdzie pani się urodziła?","placeholder":"Напиши место рождения по-польски."},{"id":"s12","nav":"Mieszkam","kind":"lesson","type":"phrase","k":"сейчас","title":"Teraz mieszkam w Gruzji.","text":"Сейчас я живу в Грузии."},{"id":"s13","nav":"w Gruzji","kind":"lesson","type":"rule","k":"готовая модель","title":"w Gruzji","text":"Gruzja → w Gruzji. Сейчас достаточно запомнить фразу целиком.","tip":"На интервью это лучше держать как готовую безопасную фразу: Teraz mieszkam w Gruzji."},{"id":"s14","nav":"Где живу","kind":"task","type":"formText","k":"задание","title":"Скажи, где ты живёшь сейчас","prompt":"Пользователь пишет, где сейчас живёт.","formId":"intro.lives.clean.v2","formTitle":"Где живу сейчас","label":"Gdzie teraz pani mieszka?","placeholder":"Напиши, где ты живёшь сейчас."},{"id":"s15","nav":"Польский","kind":"lesson","type":"phrase","k":"язык","title":"Znam język polski tylko trochę.","text":"Я знаю польский только немного."},{"id":"s16","nav":"Хочу говорить","kind":"lesson","type":"phrase","k":"цель","title":"Chcę lepiej mówić po polsku.","text":"Я хочу лучше говорить по-польски."},{"id":"s17","nav":"Язык","kind":"task","type":"formTextArea","k":"задание","title":"Скажи про польский язык","prompt":"Пользователь пишет 1–2 предложения о знании польского.","formId":"intro.polish.clean.v2","formTitle":"Мой польский язык","label":"Co pani może powiedzieć o języku polskim?","placeholder":"Напиши 1–2 предложения по-польски."},{"id":"s18","nav":"Культура","kind":"lesson","type":"phrase","k":"мотивация","title":"Interesuje mnie polska kultura.","text":"Мне интересна польская культура."},{"id":"s19","nav":"Свободнее","kind":"lesson","type":"phrase","k":"мотивация","title":"Chciałabym swobodniej mówić po polsku.","text":"Я хотела бы свободнее говорить по-польски."},{"id":"s20","nav":"Почему","kind":"task","type":"formTextArea","k":"задание","title":"Почему ты учишь польский?","prompt":"Пользователь пишет короткую мотивацию учить польский.","formId":"intro.why.clean.v2","formTitle":"Почему я учу польский","label":"Dlaczego uczy się pani języka polskiego?","placeholder":"Напиши короткую причину по-польски."},{"id":"s21","nav":"Корни","kind":"lesson","type":"phrase","k":"семья","title":"Moja babcia była Polką.","text":"Моя бабушка была полькой."},{"id":"s22","nav":"Polką","kind":"lesson","type":"rule","k":"готовая модель","title":"była Polką","text":"Не разбираем все падежи сейчас. Просто учим готовую фразу: moja babcia była Polką.","tip":"Фраза пригодится на вопрос о польских корнях. Лучше произнести её уверенно и просто."},{"id":"s23","nav":"Корни","kind":"task","type":"formTextArea","k":"задание","title":"Скажи про польские корни","prompt":"Пользователь пишет 1–2 предложения о польских корнях.","formId":"intro.roots.clean.v2","formTitle":"Польские корни","label":"Proszę powiedzieć o swoich polskich korzeniach.","placeholder":"Напиши 1–2 предложения о корнях."},{"id":"s24","nav":"Quiz 1","kind":"task","type":"formChoice","k":"мини-тест","title":"Как сказать “я родилась”?","prompt":"Проверка формы urodziłam się.","formId":"quiz.birth.clean.v2","formTitle":"Мини-тест: urodziłam się","field":"answer","options":[["urodziłam się","urodziłam się"],["urodziłem się","urodziłem się"],["mieszkam","mieszkam"]]},{"id":"s25","nav":"Quiz 2","kind":"task","type":"formChoice","k":"мини-тест","title":"Как сказать “в Грузии”?","prompt":"Проверка формы w Gruzji.","formId":"quiz.gruzji.clean.v2","formTitle":"Мини-тест: w Gruzji","field":"answer","options":[["w Gruzja","w Gruzja"],["w Gruzji","w Gruzji"],["w Gruzję","w Gruzję"]]},{"id":"s26","nav":"Спойлер","kind":"lesson","type":"spoiler","k":"если интересно","title":"Почему формы слов меняются?","text":"Польский часто меняет форму слова после предлогов. На старте безопаснее учить готовые мини-модели: w Gruzji, w Polsce, była Polką."},{"id":"s27","nav":"Полный текст","kind":"lesson","type":"modal","k":"собираем вместе","title":"Открой полный текст","text":"Повтори весь монолог целиком, когда короткие кирпичи уже понятны."},{"id":"s28","nav":"Итог","kind":"task","type":"formTextArea","k":"итоговая практика","title":"Собери 5–7 предложений","prompt":"Пользователь собирает короткий рассказ о себе после урока.","formId":"intro.final.clean.v2","formTitle":"Итоговый рассказ","label":"Napisz kilka zdań o sobie.","placeholder":"Собери свой рассказ: 5–7 предложений."},{"id":"s29","nav":"Самооценка","kind":"task","type":"formChoice","k":"чекпоинт","title":"Как сейчас ощущается тема?","prompt":"Самооценка после урока.","formId":"checkpoint.confidence.clean.v2","formTitle":"Самооценка","field":"confidence","options":[["low","мне сложно"],["mid","примерно понимаю"],["high","уверенно"]]},{"id":"s30","nav":"Export","kind":"system","type":"export","k":"готово","title":"Отправь результат в чат","text":"Нажми кнопку, скопируй результат и вставь его в чат. Я проверю ответы и предложу следующий шаг."}]